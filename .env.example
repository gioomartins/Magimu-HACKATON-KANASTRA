# Copie para .env (cp .env.example .env) e ajuste se necessário.
# Lido pelo docker compose (raiz) e pelo Django (backend/config/settings.py).

# --- PostgreSQL ---
POSTGRES_DB=antecipe
POSTGRES_USER=antecipe
POSTGRES_PASSWORD=antecipe
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=troque-esta-chave-em-producao
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Antecipe ---
ANTECIPE_DATA_BASE=2026-10-22
ANTECIPE_CHUNK_SIZE=10000
# ANTECIPE_VALIDADORES_PATH=/caminho/para/validadores_antecipe.json
# ANTECIPE_SITUACAO_CNPJ_PATH=/caminho/para/cnpj_situacao_mock.csv
